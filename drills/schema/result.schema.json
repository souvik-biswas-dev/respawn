{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "respawn-drill-result",
  "title": "Respawn drill result",
  "description": "One file per drill run, drills/results/<drill>-<UTC timestamp>.json. See docs/DRILLS.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["drill", "mode", "started_at", "fault_injected_at", "recovered_at", "rto_seconds", "last_seq_before", "first_seq_after", "rpo_seconds", "alerts_fired", "steps", "notes", "environment"],
  "properties": {
    "drill": { "enum": ["kill-node", "fill-disk", "delete-server"] },
    "mode": { "enum": ["real", "simulated"] },
    "label": { "const": "SIMULATED", "description": "Required when mode is simulated." },
    "started_at": { "$ref": "#/definitions/utc" },
    "fault_injected_at": { "$ref": "#/definitions/utc" },
    "recovered_at": { "$ref": "#/definitions/utc" },
    "rto_seconds": { "type": "integer", "minimum": 0 },
    "last_seq_before": { "type": "integer", "minimum": 0 },
    "first_seq_after": { "type": "integer", "minimum": 0 },
    "rpo_seconds": { "type": "number", "minimum": 0 },
    "alerts_fired": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "seconds"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "seconds": { "type": "number", "minimum": 0 }
        }
      }
    },
    "notes": { "type": "string" },
    "environment": {
      "type": "object",
      "required": ["provider"],
      "additionalProperties": { "type": "string" },
      "properties": { "provider": { "type": "string", "minLength": 1 } }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "simulated" } }, "required": ["mode"] },
      "then": { "required": ["label"] }
    }
  ],
  "definitions": {
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
  }
}
