{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "respawn-drill-summary",
  "title": "Respawn drill summary",
  "description": "drills/results/summary.json: the best run per drill. A real run always wins over a simulated one.",
  "type": "object",
  "additionalProperties": false,
  "required": ["generated_at", "mode", "drills"],
  "properties": {
    "generated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "mode": { "enum": ["real", "simulated", "mixed", "none"] },
    "label": { "const": "SIMULATED", "description": "Present when any entry is simulated." },
    "drills": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kill-node": { "$ref": "#/definitions/entry" },
        "fill-disk": { "$ref": "#/definitions/entry" },
        "delete-server": { "$ref": "#/definitions/entry" }
      }
    }
  },
  "definitions": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "mode", "recovered_at", "rto_seconds", "rpo_seconds"],
      "properties": {
        "file": { "type": "string" },
        "mode": { "enum": ["real", "simulated"] },
        "label": { "const": "SIMULATED" },
        "recovered_at": { "type": "string" },
        "rto_seconds": { "type": "integer", "minimum": 0 },
        "rpo_seconds": { "type": "number", "minimum": 0 }
      }
    }
  }
}
