# Copy to terraform.tfvars (git-ignored) and edit. Contains no secrets:
# API tokens go in environment variables, see docs/RUNBOOK.md section 0.
#   export HCLOUD_TOKEN=...            (Hetzner)
#   export TF_VAR_cloudflare_api_token=...   (only if enable_dns = true)

name        = "respawn"
location    = "nbg1"
server_type = "cx22" # check current names and prices: hcloud server-type list

# Your PUBLIC key only (cat ~/.ssh/id_ed25519.pub). This one is a placeholder.
ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEXAMPLEEXAMPLEEXAMPLEEXAMPLEEXAMPLEEXAMPLE0000 you@example"

# Your own public IP as /32 (find it with: curl -s https://ifconfig.me). 203.0.113.0/24 is a documentation range.
ssh_allowed_cidrs      = ["203.0.113.10/32"]
kube_api_allowed_cidrs = ["203.0.113.10/32"]

# Turn on only if you own a domain managed in Cloudflare.
enable_dns         = false
cloudflare_zone_id = ""
dns_record_name    = "respawn"

# Set true to guard against accidents; set false before the delete-server drill.
delete_protection = false
